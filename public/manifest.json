{
  "manifest_version": 3,
  "name": "OrbitNest — Browser Tab Universe",
  "short_name": "OrbitNest",
  "version": "0.2.0",
  "description": "Your tabs. Your universe. Open the OrbitNest tab dashboard (early preview).",
  "action": {
    "default_title": "Open OrbitNest Universe",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
